pipeline {
    agent any

    tools {
        maven 'Maven-3.9.9'  // Use your configured Maven tool name here
    }

    parameters {
        // Dropdown for selecting Git branch (requires Git Parameter Plugin)
        gitParameter(name: 'BRANCH',
                     type: 'PT_BRANCH',
                     defaultValue: 'main',
                     branchFilter: '.*',
                     sortMode: 'ASCENDING',
                     description: 'Select Git branch to test')

        // Optional: Feature file name (e.g. Login.feature)
        string(name: 'FEATURE',
               defaultValue: '',
               description: 'Feature file to run (e.g. Login.feature). Leave empty to run all features.')

        // Optional: Cucumber tag (e.g. @smoke)
        string(name: 'TAG',
               defaultValue: '',
               description: 'Tag to run (e.g. @smoke). Leave empty to run all scenarios.')
    }

    environment {
        // Use the Maven executable provided by Jenkins tools, no need to hardcode 'mvn'
        MAVEN_CMD = "${tool 'Maven-3.9.9'}/bin/mvn"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "${params.BRANCH}"]],
                    userRemoteConfigs: [[url: 'https://github.com/suchhanda046/Demo.git']]
                ])
            }
        }

        stage('Run Tests') {
            steps {
                script {
                    def cmd = "${env.MAVEN_CMD} test"

                    if (params.FEATURE?.trim()) {
                        cmd += " -Dcucumber.features=src/test/resources/${params.FEATURE.trim()}"
                    }

                    if (params.TAG?.trim()) {
                        cmd += " -Dcucumber.filter.tags=${params.TAG.trim()}"
                    }

                    echo "Running command: ${cmd}"
                    sh cmd
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'target/cucumber-reports/**/*', allowEmptyArchive: true
        }
    }
}
